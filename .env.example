# API
NODE_ENV=development
PORT=3000
TEST_MODE_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/routeshare
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# OTP anti-abuse (generate a random secret of at least 32 characters)
OTP_ABUSE_HMAC_SECRET=replace-with-a-long-random-secret
OTP_DEVICE_MONTHLY_LIMIT=5
OTP_PHONE_DAILY_LIMIT=3
OTP_IP_TEN_MINUTES_LIMIT=10

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
